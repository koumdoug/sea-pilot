# ════════════════════════════════════════════════════════════════════
#  SEA Pilot — variables d'environnement
#  Copiez ce fichier en `.env` (jamais committé) et renseignez les valeurs.
# ════════════════════════════════════════════════════════════════════

# ── Base de données ─────────────────────────────────────────────────
# SQLite (développement) : file:./dev.db     (chemin relatif au dossier prisma/)
# PostgreSQL (production) : postgresql://USER:PASSWORD@HOST:5432/DB?schema=public
DATABASE_URL="file:./dev.db"

# ── Application ─────────────────────────────────────────────────────
# URL publique de l'application (liens d'e-mails, OAuth, Stripe, sitemap, URL canoniques). Sans slash final.
APP_URL="http://localhost:3000"
# Secret de signature des sessions et des liens de désinscription (>= 32 caractères).
# Générer : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Clé de chiffrement des identifiants d'intégration (AES-256-GCM). Défaut : SESSION_SECRET. Recommandé : une clé dédiée en production.
ENCRYPTION_KEY=
# Exemption de facturation du PROPRIÉTAIRE de la plateforme : identifiants d'utilisateurs (Réglages → Profil → « Identifiant du compte »), séparés par des virgules.
# Seul le rôle « owner » de l'espace de ces utilisateurs est exempté. Vide (défaut) = aucune exception ; aucun autre utilisateur n'est jamais exempté.
FREE_ACCESS_USER_IDS=
# Secret de la tâche planifiée /api/cron/followups (Authorization: Bearer <CRON_SECRET>).
CRON_SECRET=
# Durée de l'essai gratuit en jours (défaut 14).
TRIAL_DAYS=14
# Informations légales affichées dans les pages Confidentialité et Conditions.
LEGAL_ENTITY_NAME=
LEGAL_CONTACT_EMAIL=

# ── IA (au moins un fournisseur pour activer les fonctions IA) ──────
# Fournisseur forcé : openai | anthropic | gemini. Vide = premier fournisseur configuré.
AI_PROVIDER=
OPENAI_API_KEY=
OPENAI_MODEL=
# Base URL compatible OpenAI (optionnel : Azure, proxy, serveur local…)
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=
# Défaut : claude-sonnet-5-5
ANTHROPIC_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
# Garde-fous
AI_TIMEOUT_MS=60000
AI_MAX_OUTPUT_TOKENS=4000
AI_DAILY_LIMIT_PER_WORKSPACE=200
AI_RATE_LIMIT_PER_MIN=10
# Tarifs en USD par million de jetons, pour l'estimation de coût. Vides = coût non estimé (jamais inventé).
AI_PRICE_IN_PER_MTOK=
AI_PRICE_OUT_PER_MTOK=

# ── E-mail système (réinitialisation de mot de passe) ───────────────
# Sans ces variables : en développement l'e-mail est écrit dans la console ; en production il n'est PAS envoyé.
RESEND_API_KEY=
EMAIL_FROM="SEA Pilot <no-reply@votre-domaine.com>"

# ── Facturation Stripe ──────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# IDs de prix Stripe (price_…) des trois plans
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_PRO=
# Libellés de tarif affichés (optionnel), ex. "29 € / mois"
PLAN_STARTER_PRICE_LABEL=
PLAN_GROWTH_PRICE_LABEL=
PLAN_PRO_PRICE_LABEL=

# ── Intégrations OAuth (par plateforme) ─────────────────────────────
# Redirection à déclarer chez chaque fournisseur : ${APP_URL}/api/integrations/<provider>/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
META_APP_ID=
META_APP_SECRET=
TIKTOK_APP_ID=
TIKTOK_APP_SECRET=

# ── Journalisation ──────────────────────────────────────────────────
# debug | info | warn | error | silent
LOG_LEVEL=info
